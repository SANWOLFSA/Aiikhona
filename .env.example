# VITE_GEMINI_API_KEY: Required for Client-Side Gemini AI calls on Netlify.
# AI Studio usually injects this at runtime via the backend.
# But since this is a client-side architecture for Netlify, you MUST set it here.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase Config Keys (Required for Netlify deployments)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
